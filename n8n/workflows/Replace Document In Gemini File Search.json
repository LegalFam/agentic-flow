              "placeholder": "URL, repositorio u origen documental",
              "defaultValue": "={{ $json.metadata.fuente || '' }}"
            },
            {
              "fieldLabel": "categoriasJSON",
              "fieldType": "textarea",
              "placeholder": "[{\"categoria\":\"Generales\",\"subcategorias\":[\"Otros\"]}]",
              "defaultValue": "={{ JSON.stringify($json.metadata.categorias || [{ categoria: 'Generales', subcategorias: ['Otros'] }], null, 2) }}",
              "requiredField": true
            },
            {
              "fieldLabel": "confidence",
              "fieldType": "number",
              "defaultValue": "={{ $json.metadata.confidence || 0.5 }}"
            },
            {
              "fieldLabel": "observaciones",
