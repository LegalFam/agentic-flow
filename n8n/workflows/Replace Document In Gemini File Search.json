        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { filename: $('Take Conversion Result').item.json.mdName, file_search_store_name: $('Set Resolved Config').item.json.fileSearchStoreName } }}",
        "options": {}
      },
      "id": "a1b2c3d4-0000-4000-8000-000000000015",
      "name": "API - Plan Replacement",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
