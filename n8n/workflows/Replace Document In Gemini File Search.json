    {
      "parameters": {
        "jsCode": "const job = $json;\nif (!job.result) {\n  throw new Error(`Conversion job ${job.job_id} completed without a result`);\n}\n// El display_name con el que se indexa es el nombre del markdown, y ese sale del\n// document_id: \"<stem>-<sha256(pdf)[:12]>.md\". Mismo criterio que el flujo de conversion,\n// porque si aca se nombrara distinto el reemplazo no encontraria la version vieja.\nreturn [{ json: { ...job.result, mdName: `${job.result.document_id}.md` } }];"
      },
      "id": "a1b2c3d4-0000-4000-8000-000000000013",
      "name": "Take Conversion Result",
