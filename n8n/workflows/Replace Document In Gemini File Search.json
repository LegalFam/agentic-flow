        "resume": "form",
        "formTitle": "Confirm Document Replacement In Gemini File Search",
        "formDescription": "=Este paso BORRA la version anterior del store, y el borrado no se deshace.\n\nStore: {{ $json.fileSearchStoreDisplayName }} ({{ $json.storeDocuments }} documentos)\nPDF nuevo: {{ $json.pdfName }}\nSe indexara como: {{ $json.mdName }}\nLlave de reemplazo: {{ $json.replacementKey }}\nCorpus del locator: {{ $json.corpusTarget }}\n\nSE VA A BORRAR:\n{{ $json.supersededSummary }}\n\nVeredicto: {{ $json.verdict }}\n{{ $json.advice }}",
        "formFields": {
