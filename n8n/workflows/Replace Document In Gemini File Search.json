            },
            {
              "fieldLabel": "supersedes",
              "fieldType": "textarea",
              "placeholder": "Un display_name por linea. Vacio = lo que decidio el plan",
              "defaultValue": "={{ $json.supersedesDefault }}"
            },
            {
              "fieldLabel": "replaceDecision",
              "fieldType": "dropdown",
              "defaultValue": "skip",
              "fieldOptions": {
                "values": [
                  {
