    {
      "parameters": {
        "jsCode": "const plan = $json;\nconst converted = $('Take Conversion Result').item.json;\nconst metadata = $('API - Extract Metadata').item.json.metadata || {};\nconst config = $('Set Resolved Config').item.json;\n\nconst superseded = plan.superseded || [];\nconst supersededNames = superseded.map((doc) => doc.display_name);\n// Lo que el formulario tiene que dejar ver es exactamente lo que se va a borrar: en File\n// Search el borrado no se deshace y no queda version anterior a la que volver.\nconst supersededSummary = superseded.length\n  ? superseded.map((doc) => `- ${doc.display_name} (${doc.size_bytes} bytes)`).join('\\n')\n  : '- (ninguno)';\n\nconst advice = {\n  replace: 'Se reemplaza una sola version. Es el caso normal.',\n  identical: 'ESTE PDF YA ESTA INDEXADO con el mismo nombre, o sea es el mismo archivo byte a byte. Revisa que no hayas tomado el PDF viejo.',\n  new: 'NO HAY NADA QUE REEMPLAZAR con esa llave. Si de verdad es un documento nuevo, usa el flujo de alta. Si es una actualizacion cuyo PDF fue renombrado, pon el nombre viejo en supersedes.',\n  ambiguous: 'VARIOS DOCUMENTOS casan con la llave. Deja en supersedes solo el que corresponde, o el reemplazo se rechaza.',\n}[plan.verdict] || '';\n\nreturn [{\n  json: {\n    mdName: converted.mdName,\n    documentId: converted.document_id,\n    pdfName: converted.filename,\n    pages: converted.pages,\n    ocrUsed: converted.ocr_used,\n    fileSearchStoreName: config.fileSearchStoreName,\n    fileSearchStoreDisplayName: config.fileSearchStoreDisplayName,\n    processedPdfFolderId: config.processedPdfFolderId,\n    replaceLogFolderId: config.replaceLogFolderId,\n    errorsFolderId: config.errorsFolderId,\n    corpusBucket: config.corpusBucket,\n    corpusTarget: config.corpusBucket\n      ? `bucket ${config.corpusBucket} (lo sube este flujo antes de reemplazar)`\n      : 'volumen local, lo sincroniza la API',\n    verdict: plan.verdict,\n    // Solo se precarga cuando hay una sola version que reemplazar. En el caso ambiguo\n    // precargar los dos candidatos convertiria \"aceptar sin tocar nada\" en borrarlos\n    // todos: ahi el campo va vacio y la API rechaza con 409 hasta que alguien escriba\n    // el nombre exacto.\n    supersedesDefault: plan.verdict === 'replace' ? supersededNames.join('\\n') : '',\n    planMessage: plan.message,\n    replacementKey: plan.replacement_key,\n    storeDocuments: plan.documents,\n    superseded,\n    supersededNames,\n    supersededSummary,\n    advice,\n    metadata,\n  },\n}];"
      },
      "id": "a1b2c3d4-0000-4000-8000-000000000016",
      "name": "Prepare Replacement Review",
      "type": "n8n-nodes-base.code",
