      },
      "id": "a1b2c3d4-0000-4000-8000-000000000017",
      "name": "Wait - Replacement Review Form",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1700,
        -96
      ],
      "webhookId": "replacement-review"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "should-replace",
              "leftValue": "={{ $json['replaceDecision'] }}",
              "rightValue": "replace",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0000-4000-8000-000000000018",
      "name": "IF - Replace Decision",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1920,
        -96
      ]
    },
    {
      "parameters": {
        "jsCode": "const form = $('Wait - Replacement Review Form').first().json;\nconst review = $('Prepare Replacement Review').first().json;\nconst reviewed = review.metadata || {};\n// El markdown se lee del resultado de la conversion, no de un campo del formulario: el\n// Codigo Civil pasa el megabyte y no tiene por que viajar por el form.\nconst markdown = $('Take Conversion Result').first().json.markdown;\nif (!markdown) {\n  throw new Error('La conversion no dejo markdown para reemplazar');\n}\n\nconst emptyToNull = (value) =>\n  value === undefined || value === null || String(value).trim() === '' ? null : String(value).trim();\nconst formValue = (...keys) => {\n  for (const key of keys) {\n    if (form[key] !== undefined && form[key] !== null && String(form[key]).trim() !== '') {\n      return form[key];\n    }\n  }\n  return undefined;\n};\nconst submittedValue = (...keys) => {\n  for (const key of keys) {\n    if (Object.prototype.hasOwnProperty.call(form, key)) {\n      return form[key];\n    }\n  }\n  return undefined;\n};\nconst normalizeSubmittedValue = (value) => (value === undefined || value === null ? null : String(value).trim());\nconst metadataValue = (key, ...aliases) => {\n  const value = submittedValue(key, ...aliases);\n  return value !== undefined ? normalizeSubmittedValue(value) : emptyToNull(reviewed[key]);\n};\n\nlet categorias;\ntry {\n  const categoriasRaw =\n    formValue('categoriasJSON', 'categoriasJson', 'CategoriasJSON') ?? JSON.stringify(reviewed.categorias || []);\n  categorias = JSON.parse(categoriasRaw || '[]');\n} catch (error) {\n  throw new Error(`Categorias JSON invalido: ${error.message}`);\n}\nif (!Array.isArray(categorias) || categorias.length === 0) {\n  throw new Error('Categorias JSON debe ser un arreglo con al menos una categoria');\n}\nconst confidenceRaw = formValue('confidence', 'Confidence') ?? reviewed.confidence ?? 0.5;\nconst confidence = Number(confidenceRaw);\nif (!Number.isFinite(confidence)) {\n  throw new Error(`confidence debe ser numerico: ${confidenceRaw}`);\n}\n\nconst metadata = {\n  titulo: metadataValue('titulo', 'Titulo'),\n  identificador: metadataValue('identificador', 'Identificador'),\n  entidad: metadataValue('entidad', 'Entidad'),\n  fecha: metadataValue('fecha', 'Fecha'),\n  materia: metadataValue('materia', 'Materia'),\n  expediente: metadataValue('expediente', 'Expediente'),\n  articulo: metadataValue('articulo', 'Articulo'),\n  norma: metadataValue('norma', 'Norma'),\n  pleno: metadataValue('pleno', 'Pleno'),\n  protocolo: metadataValue('protocolo', 'Protocolo'),\n  fuente: metadataValue('fuente', 'Fuente', 'source'),\n  categorias,\n  confidence,\n  observaciones: metadataValue('observaciones', 'Observaciones'),\n};\n\n// Lo que el revisor dejo en el textarea manda sobre lo que dedujo el plan. Es la unica\n// salida para el caso ambiguo y para el PDF que cambio de nombre entre revisiones.\nconst supersedes = String(formValue('supersedes', 'Supersedes') ?? '')\n  .split('\\n')\n  .map((line) => line.trim())\n  .filter(Boolean);\n\nconst corpusBucket = String($('Set Resolved Config').first().json.corpusBucket || '').trim();\n\nreturn [{\n  json: {\n    filename: form.mdName,\n    markdown,\n    metadata,\n    file_search_store_name: form.fileSearchStoreName,\n    supersedes,\n    // Un alta nueva no se cuela por aca: si el plan no encontro nada que reemplazar y el\n    // revisor no escribio un supersedes, la API responde 409 y el PDF no se mueve.\n    allow_new: false,\n    allow_multiple: supersedes.length > 1,\n    // Con bucket el markdown ya viaja al corpus antes del reemplazo y el mount es de\n    // solo lectura: pedirle a la API que escriba solo agregaria un warning esperado.\n    // Sin bucket (local) /work/corpus es escribible y la API lo sincroniza sola.\n    sync_corpus: !corpusBucket,\n    wait_until_done: true,\n    max_wait_seconds: 900,\n    corpusBucket,\n    // El corpus se monta en la raiz del bucket (mount-path=/corpus), asi que el nombre\n    // del objeto es el nombre del markdown, sin prefijo.\n    corpusObjectName: form.mdName,\n    verdict: review.verdict,\n    pdfName: review.pdfName,\n    processedPdfFolderId: form.processedPdfFolderId,\n    replaceLogFolderId: form.replaceLogFolderId,\n    errorsFolderId: form.errorsFolderId,\n  },\n}];"
      },
      "id": "a1b2c3d4-0000-4000-8000-000000000019",
      "name": "Prepare Replace Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2140,
        -192
