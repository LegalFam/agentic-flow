        "jsCode": "const err = $json;\nconst source = $('Google Drive - Download PDF').item?.json || {};\nconst filename = source.name || 'unknown.pdf';\nconst safeName = filename.replace(/[^a-zA-Z0-9_.-]+/g, '-');\n// Un 409 no es una caida: es la API negandose a borrar sin que alguien decida cual. Se\n// registra igual, y el PDF se queda en la carpeta de updates para reintentarlo bien.\nconst record = { filename, error: err, happened_at: new Date().toISOString() };\nconst item = { json: { errorName: `${safeName}.replace-error.json`, record }, binary: {} };\nitem.binary.error = await this.helpers.prepareBinaryData(\n  Buffer.from(JSON.stringify(record, null, 2), 'utf8'),\n  item.json.errorName,\n  'application/json'\n);\nreturn [item];"
