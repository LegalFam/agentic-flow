{
  "name": "Rollback Norm Update",
  "nodes": [
    {
      "parameters": {},
      "id": "b2c3d4e5-0003-4000-8000-000000000001",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -880,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "store-display-name",
              "name": "fileSearchStoreDisplayName",
              "value": "FamilyLaw",
              "type": "string"
            },
            {
              "id": "api-base-url",
              "name": "processingApiBaseUrl",
              "value": "={{ $env.PROCESSING_API_BASE_URL || 'http://processing-api:8000' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "b2c3d4e5-0003-4000-8000-000000000002",
      "name": "Edit Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -660,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.processingApiBaseUrl + '/file-search-stores/resolve' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { display_name: $json.fileSearchStoreDisplayName, create_if_missing: false } }}",
        "options": {}
      },
      "id": "b2c3d4e5-0003-4000-8000-000000000003",
      "name": "API - Resolve File Search Store",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -440,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{ $('Edit Config').item.json.processingApiBaseUrl + '/amendments/backups' }}",
        "options": {}
      },
      "id": "b2c3d4e5-0003-4000-8000-000000000004",
      "name": "API - List Backups",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -220,
        0
      ]
    },
    {
      "parameters": {
        "resume": "form",
        "formTitle": "Rollback de una actualizacion de norma",
        "formDescription": "=Restaura en el store la version guardada en una copia de seguridad y saca la version que la reemplazo. Lo que se saca tambien se respalda antes, asi que el rollback se puede deshacer.\n\nCOPIAS DISPONIBLES (backup_id | documento | motivo | reemplazado por):\n{{ ($json.backups || []).slice(-30).map(b => b.backup_id + ' | ' + b.document + ' | ' + b.reason + ' | ' + (b.replaced_by || '-')).join('\\n') }}",
        "formFields": {
          "values": [
            {
              "fieldName": "fileSearchStoreName",
              "fieldType": "hiddenField",
              "fieldValue": "={{ $('API - Resolve File Search Store').item.json.name }}"
            },
            {
              "fieldLabel": "backupId",
              "placeholder": "20261118T120000-abc123",
              "requiredField": true
            },
            {
              "fieldLabel": "decidedBy",
              "placeholder": "Quien ordena el rollback",
              "requiredField": true
            },
            {
              "fieldLabel": "confirm",
              "fieldType": "dropdown",
              "defaultValue": "no",
              "fieldOptions": {
                "values": [
                  {
                    "option": "no"
                  },
                  {
                    "option": "rollback"
                  }
                ]
              },
              "requiredField": true
            }
          ]
        },
        "options": {}
      },
      "id": "b2c3d4e5-0003-4000-8000-000000000005",
      "name": "Wait - Rollback Form",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "webhookId": "c7d1e2f3-0003-4000-8000-000000000005"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "confirmed",
              "leftValue": "={{ $json.confirm }}",
              "rightValue": "rollback",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2c3d4e5-0003-4000-8000-000000000006",
      "name": "IF - Confirmed",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Edit Config').item.json.processingApiBaseUrl + '/amendments/rollback' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { backup_id: $json.backupId, decided_by: $json.decidedBy, file_search_store_name: $json.fileSearchStoreName } }}",
        "options": {
          "timeout": 1800000
        }
      },
      "id": "b2c3d4e5-0003-4000-8000-000000000007",
      "name": "API - Rollback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        -80
      ]
    }
  ],
