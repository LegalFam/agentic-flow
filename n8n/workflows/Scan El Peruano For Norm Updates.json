      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -900,
        100
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "store-display-name",
              "name": "fileSearchStoreDisplayName",
              "value": "FamilyLaw",
              "type": "string"
            },
            {
              "id": "api-base-url",
