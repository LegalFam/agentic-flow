      "name": "Split Proposals",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const config = $('Set Resolved Config').first().json;\nconst MAX_DIFF = 12000;\nreturn $input.all().map((item) => {\n  const p = item.json;\n  const changes = p.changes || [];\n  const line = (c) => `- [${c.status}] ${c.norma} (${c.fecha})${c.articulo ? ' art. ' + c.articulo : ''}: ${c.detalle}`;\n  const normas = (p.normas || []).map((n) => `- ${n.fecha} ${n.url}`).join('\\n');\n  const diff = p.diff || '(sin cambios en el texto)';\n  const advice = {\n    revise: 'Se subira una version nueva con las notas (*) y se borrara la actual. Antes se guarda una copia exacta para rollback.',\n    delete: 'DEROGACION TOTAL: el documento se sacara del store. Antes se guarda una copia exacta para rollback.',\n    blocked: 'LA PROPUESTA NO PASO LA VERIFICACION y no se puede aplicar. Elige skip y revisa los avisos.',\n    none: 'No hay cambios de texto (ya aplicados o solo avisos). apply solo registra que se reviso.',\n  }[p.action] || '';\n  return { json: {\n    proposalId: p.id,\n    document: p.document,\n    action: p.action,\n    advice,\n    spij: p.spij_url || '(sin link SPIJ en el registro)',\n    normas,\n    cambios: changes.map(line).join('\\n'),\n    problemas: (p.verification_problems || []).join('\\n') || '(ninguno)',\n    diff: diff.length > MAX_DIFF ? diff.slice(0, MAX_DIFF) + '\\n... (diff recortado; completo en GET /amendments/proposals/' + p.id + ')' : diff,\n    fileSearchStoreName: config.fileSearchStoreName,\n    processingApiBaseUrl: config.processingApiBaseUrl,\n  } };\n});"
      },
      "id": "b2c3d4e5-0002-4000-8000-000000000007",
      "name": "Prepare Review",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "b2c3d4e5-0002-4000-8000-000000000008",
      "name": "Loop Over Proposals",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "resume": "form",
        "formTitle": "Revisar actualizacion de norma desde El Peruano",
        "formDescription": "=Documento: {{ $json.document }}\nAccion propuesta: {{ $json.action }}\n{{ $json.advice }}\n\nContrasta con el texto vigente en SPIJ (abrelo desde Peru): {{ $json.spij }}\n\nNORMAS DE EL PERUANO:\n{{ $json.normas }}\n\nCAMBIOS:\n{{ $json.cambios }}\n\nPROBLEMAS DE VERIFICACION:\n{{ $json.problemas }}\n\nDIFF (solo debe haber lineas +):\n{{ $json.diff }}",
        "formFields": {
          "values": [
            {
              "fieldName": "proposalId",
              "fieldType": "hiddenField",
              "fieldValue": "={{ $json.proposalId }}"
            },
            {
              "fieldName": "fileSearchStoreName",
              "fieldType": "hiddenField",
              "fieldValue": "={{ $json.fileSearchStoreName }}"
            },
            {
              "fieldLabel": "decidedBy",
              "placeholder": "Quien revisa",
              "requiredField": true
            },
            {
              "fieldLabel": "decision",
              "fieldType": "dropdown",
              "defaultValue": "skip",
              "fieldOptions": {
                "values": [
                  {
                    "option": "skip"
                  },
                  {
                    "option": "apply"
                  }
                ]
              },
              "requiredField": true
            }
          ]
        },
        "options": {}
      },
      "id": "b2c3d4e5-0002-4000-8000-000000000009",
      "name": "Wait - Review Form",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        660,
        100
      ],
      "webhookId": "c7d1e2f3-0002-4000-8000-000000000009"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Set Resolved Config').first().json.processingApiBaseUrl + '/amendments/decide' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { proposal_id: $json.proposalId, decision: $json.decision, decided_by: $json.decidedBy, file_search_store_name: $json.fileSearchStoreName } }}",
        "options": {
          "timeout": 1800000
        }
      },
      "id": "b2c3d4e5-0002-4000-8000-000000000010",
